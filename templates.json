{
  "version": "3",
  "templates": [
    {
      "type": 3,
      "title": "Pangolin CLI",
      "name": "pangolin-site",
      "description": "Pangolin CLI for Portainer",
      "categories": [
        "edge"
      ],
      "logo": "https://docs.pangolin.net/icon0.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "containers/pangolin-cli/compose.yml"
      },
      "env": [
        {
          "name": "PANGOLIN_ENDPOINT",
          "label": "Endpoint",
          "default": "https://pangolin.fossorial.io"
        },
        {
          "name": "SITE_ID",
          "label": "Site ID"
        },
        {
          "name": "SITE_SECRET",
          "label": "Site Secret"
        },
        {
          "name": "DISABLE_CLIENTS",
          "label": "Client Connections",
          "select": [
            {
              "text": "Accept Client Connections",
              "value": "false",
              "default": true
            },
            {
              "text": "Disable Client Connections",
              "value": "true"
            }
          ]
        }
      ]
    },
    {
      "id": 10,
      "type": 1,
      "title": "PostgreSQL",
      "name": "postgres",
      "description": "The most advanced open-source database",
      "categories": [
        "database"
      ],
      "platform": "linux",
      "logo": "https://www.postgresql.org/media/img/about/press/elephant.png",
      "image": "postgres:latest",
      "env": [
        {
          "name": "POSTGRES_USER",
          "label": "Root user",
          "default": "postgres"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "label": "Root password",
          "default": "postgres"
        },
        {
          "preset": true,
          "name": "PGDATA",
          "default": "/var/lib/postgresql/data"
        }
      ],
      "ports": [
        "5432/tcp"
      ],
      "volumes": [
        {
          "container": "/var/lib/postgresql/data"
        }
      ]
    }
  ]
}
