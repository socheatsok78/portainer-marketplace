{
  "version": "3",
  "templates": [
    {
      "type": 3,
      "title": "n8n",
      "name": "n8n",
      "description": "The Platform for AI Agents and Workflow Automation",
      "categories": [
        "automation",
        "workflow",
        "ai"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/n8n/logo.png",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/n8n/compose.yml"
      },
      "env": [
        {
          "name": "N8N_RUNNERS_AUTH_TOKEN",
          "label": "N8N_RUNNERS_AUTH_TOKEN",
          "description": "Shared secret used to authenticate runner processes with the broker.",
          "default": "$ openssl rand -hex 24"
        },
        {
          "name": "SANDBOX_API_KEYS",
          "label": "SANDBOX_API_KEYS",
          "description": "Comma-separated admin API keys. Full access to all sandboxes and `/admin/tenants` key management.",
          "default": "$ openssl rand -hex 24"
        },
        {
          "name": "SANDBOX_API_RUNNER_API_KEY",
          "label": "SANDBOX_API_RUNNER_API_KEY",
          "description": "API key injected by the API when calling runner HTTP",
          "default": "$ openssl rand -hex 24"
        },
        {
          "name": "SANDBOX_API_RUNNER_REGISTRATION_TOKEN",
          "label": "SANDBOX_API_RUNNER_REGISTRATION_TOKEN",
          "description": "Shared secret; runners authenticate to the private gRPC registration service",
          "default": "$ openssl rand -hex 24"
        },
        {
          "name": "SEARXNG_SECRET",
          "label": "SEARXNG_SECRET",
          "description": "Web search: secret for the bundled SearXNG instance",
          "default": "$ openssl rand -hex 24"
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "NetBird Client",
      "description": "NetBird Client for Portainer",
      "categories": [
        "edge",
        "netbird",
        "networking"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/netbird/logo.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/netbird-client/compose.yml"
      },
      "env": [
        {
          "name": "NB_MANAGEMENT_URL",
          "label": "NetBird Management URL",
          "default": "https://api.netbird.io"
        },
        {
          "name": "NB_HOSTNAME",
          "label": "NetBird Hostname",
          "default": ""
        },
        {
          "name": "NB_SETUP_KEY",
          "label": "NetBird Setup Key"
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "NetBird Reverse Proxy",
      "description": "NetBird Reverse Proxy for Portainer",
      "categories": [
        "edge",
        "netbird",
        "networking"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/netbird/logo.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/netbird-reverse-proxy/compose.yml"
      },
      "env": [
        {
          "name": "NB_PROXY_MANAGEMENT_ADDRESS",
          "label": "NetBird Management URL",
          "default": "https://api.netbird.io"
        },
        {
          "name": "NB_PROXY_DOMAIN",
          "label": "NetBird Proxy Domain"
        },
        {
          "name": "NB_PROXY_TOKEN",
          "label": "NetBird Proxy Token"
        },
        {
          "name": "NB_PROXY_PRIVATE",
          "label": "NetBird-Only Access",
          "select": [
            {
              "text": "Enable",
              "value": "true"
            },
            {
              "text": "Disable",
              "value": "false"
            }
          ]
        },
        {
          "name": "NB_PROXY_LOG_LEVEL",
          "label": "Log Level",
          "select": [
            {
              "text": "Info",
              "value": "info",
              "default": true
            },
            {
              "text": "Debug",
              "value": "debug"
            },
            {
              "text": "Trace",
              "value": "trace"
            }
          ]
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "NetBird",
      "name": "netbird",
      "description": "NetBird is an Open Source Zero Trust Networking platform that allows you to create secure private networks for your organization or home.",
      "categories": [
        "infrastructure",
        "netbird",
        "networking"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/netbird/logo.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/netbird/compose.yml"
      },
      "env": [
        {
          "name": "NB_PROXY_DOMAIN",
          "label": "NetBird FQDN domain"
        },
        {
          "name": "NB_TRAEFIK_ACME_EMAIL",
          "label": "NetBird Traefik ACME Email"
        },
        {
          "name": "NB_AUTH_SECRET",
          "label": "NetBird Auth Secret",
          "default": "$ openssl rand -base64 32 | sed 's/=//g'"
        },
        {
          "name": "NB_SESSION_ENCRYPTION_KEY",
          "label": "NetBird Session Encryption Key",
          "default": "$ openssl rand -base64 32"
        },
        {
          "name": "NB_STORE_ENCRYPTION_KEY",
          "label": "NetBird Store Encryption Key",
          "default": "$ openssl rand -base64 32"
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "Pangolin Site",
      "name": "pangolin-site",
      "description": "Pangolin Site for Portainer",
      "categories": [
        "edge"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/pangolin-site/logo.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
