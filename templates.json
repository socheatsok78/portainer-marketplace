          "name": "APP_URL",
          "label": "Pocket ID API URL",
          "default": "http://localhost:1411"
        },
        {
          "name": "ENCRYPTION_KEY",
          "label": "Encryption Key",
          "default": "$ openssl rand -base64 32"
        },
        {
          "name": "TRUST_PROXY",
          "label": "Trust Proxy",
          "select": [
            {
              "text": "Enabled",
              "value": "true",
              "default": true
            },
            {
              "text": "Disabled",
              "value": "false"
            }
          ]
        },
        {
          "name": "MAXMIND_LICENSE_KEY",
          "label": "MaxMind License Key"
        },
        {
          "name": "VERSION_CHECK_DISABLED",
          "label": "Version Check",
          "select": [
            {
              "text": "Enabled",
              "value": "false",
              "default": true
            },
            {
              "text": "Disabled",
              "value": "true"
            }
          ]
        },
        {
          "name": "ANALYTICS_DISABLED",
          "label": "Analytics",
          "select": [
            {
              "text": "Enabled",
              "value": "false"
            },
            {
              "text": "Disabled",
              "value": "true",
              "default": true
            }
          ]
        }
      ]
