    {
      "id": 10,
      "type": 1,
      "title": "PostgreSQL",
      "name": "postgres",
      "description": "The most advanced open-source database",
      "categories": [
        "database"
      ],
      "platform": "linux",
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/postgres/logo.png",
      "image": "postgres:latest",
      "env": [
        {
          "name": "POSTGRES_USER",
          "label": "Root user",
          "default": "postgres"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "label": "Root password",
          "default": "postgres"
        },
        {
          "preset": true,
          "name": "PGDATA",
          "default": "/var/lib/postgresql/data"
        }
      ],
      "ports": [
        "5432/tcp"
      ],
      "volumes": [
        {
          "container": "/var/lib/postgresql/data"
        }
      ]
    },
    {
