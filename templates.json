{
  "version": "3",
  "templates": [
    {
      "type": 3,
      "administrator_only": true,
      "title": "NetBird Peer",
      "name": "netbird",
      "description": "NetBird Peer for Portainer",
      "categories": [
        "edge"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/netbird/logo.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/netbird-peer/compose.yml"
      },
      "env": [
        {
          "name": "NB_HOSTNAME",
          "label": "NetBird Hostname",
          "default": ""
        },
        {
          "name": "NB_SETUP_KEY",
          "label": "NetBird Setup Key"
        },
        {
          "name": "NB_MANAGEMENT_URL",
          "label": "NetBird Management URL",
          "default": "https://api.netbird.io:443"
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "NetBird Self-Hosted",
      "name": "netbird",
      "description": "NetBird is an Open Source Zero Trust Networking platform that allows you to create secure private networks for your organization or home.",
      "categories": [
        "infrastructure",
        "networking"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/netbird/logo.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "netbird/netbird/compose.yml"
      },
      "env": [
        {
          "name": "NB_PROXY_DOMAIN",
          "label": "NetBird FQDN domain",
          "default": "netbird.example.com"
        },
        {
          "name": "NB_AUTH_SECRET",
          "label": "NetBird Auth Secret",
          "default": "$ openssl rand -base64 32 | sed 's/=//g'"
        },
        {
          "name": "NB_SESSION_ENCRYPTION_KEY",
          "label": "NetBird Session Encryption Key",
          "default": "$ openssl rand -base64 32"
        },
        {
          "name": "NB_STORE_ENCRYPTION_KEY",
          "label": "NetBird Store Encryption Key",
          "default": "$ openssl rand -base64 32"
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "Pangolin Site",
      "name": "pangolin-site",
      "description": "Pangolin Site for Portainer",
      "categories": [
        "edge"
      ],
      "logo": "https://docs.pangolin.net/icon0.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/pangolin-site/compose.yml"
      },
      "env": [
        {
          "name": "PANGOLIN_ENDPOINT",
          "label": "Endpoint",
          "default": "https://pangolin.fossorial.io"
        },
        {
          "name": "SITE_ID",
          "label": "Site ID"
        },
        {
          "name": "SITE_SECRET",
          "label": "Site Secret"
        },
        {
          "name": "DISABLE_CLIENTS",
          "label": "Client Connections",
          "select": [
            {
              "text": "Accept Client Connections",
              "value": "false",
              "default": true
            },
            {
              "text": "Disable Client Connections",
              "value": "true"
            }
          ]
        }
      ]
    },
    {
      "id": 10,
      "type": 1,
      "title": "PostgreSQL",
      "name": "postgres",
      "description": "The most advanced open-source database",
      "categories": [
        "database"
      ],
      "platform": "linux",
      "logo": "https://www.postgresql.org/media/img/about/press/elephant.png",
      "image": "postgres:latest",
      "env": [
        {
          "name": "POSTGRES_USER",
          "label": "Root user",
          "default": "postgres"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "label": "Root password",
          "default": "postgres"
        },
        {
          "preset": true,
          "name": "PGDATA",
          "default": "/var/lib/postgresql/data"
        }
      ],
      "ports": [
        "5432/tcp"
      ],
      "volumes": [
        {
          "container": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "id": 2,
      "type": 1,
      "title": "Registry (cache)",
      "description": "Docker image registry configured as a DockerHub pull through cache",
      "categories": [
        "docker"
      ],
      "platform": "linux",
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/registry/logo.png",
      "image": "registry:latest",
      "ports": [
        "5000/tcp"
      ],
      "volumes": [
        {
          "container": "/var/lib/registry"
        }
      ],
      "env": [
        {
          "name": "REGISTRY_PROXY_REMOTEURL",
          "default": "https://registry-1.docker.io",
          "preset": true
        }
      ]
    },
    {
      "id": 1,
      "type": 1,
      "title": "Registry",
      "description": "Docker image registry",
      "categories": [
        "docker"
      ],
      "platform": "linux",
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/registry/logo.png",
      "image": "registry:latest",
      "ports": [
        "5000/tcp"
      ],
      "volumes": [
        {
          "container": "/var/lib/registry"
        }
      ]
    },
    {
      "type": 3,
      "title": "RustFS",
      "name": "rustfs",
      "description": "RustFS is a high-performance, distributed object storage system built in Rust",
      "categories": [
        "storage",
        "open-source"
      ],
      "logo": "https://rustfs.com/apple-touch-icon.png",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/rustfs/compose.yml"
      },
      "env": [
        {
          "name": "COMPOSE_PORT_S3_API",
          "label": "S3 API port",
          "default": "9000"
        },
        {
          "name": "COMPOSE_PORT_CONSOLE",
          "label": "Console port",
          "default": "9001"
        },
        {
          "name": "RUSTFS_CONSOLE_ENABLE",
          "label": "RUSTFS_CONSOLE_ENABLE",
          "select": [
            {
              "text": "true",
              "value": "true",
              "default": true
            },
            {
              "text": "false",
              "value": "false"
            }
          ]
        },
        {
          "name": "RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS",
          "label": "RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS",
          "default": "*"
        },
        {
          "name": "RUSTFS_ACCESS_KEY",
          "label": "RUSTFS_ACCESS_KEY",
          "default": "rustfsadmin"
        },
        {
          "name": "RUSTFS_SECRET_KEY",
          "label": "RUSTFS_SECRET_KEY",
          "default": "rustfsadmin"
        },
        {
          "name": "RUSTFS_OBS_LOGGER_LEVEL",
          "label": "RUSTFS_OBS_LOGGER_LEVEL",
          "select": [
            {
              "text": "trace",
              "value": "trace"
            },
            {
              "text": "debug",
              "value": "debug"
            },
            {
              "text": "info",
              "value": "info",
              "default": true
            },
            {
              "text": "warn",
              "value": "warn"
            },
            {
              "text": "error",
              "value": "error"
            }
          ]
        }
      ]
    },
    {
      "type": 3,
      "title": "Technitium DNS Server",
      "name": "technitium-dns",
      "description": "Self host a DNS server for privacy & security",
      "categories": [
        "dns",
        "networking",
        "open-source"
      ],
      "logo": "https://socheatsok78.github.io/portainer-marketplace/templates/technitium-dns/logo.png",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/technitium-dns/compose.yml"
      },
      "env": [
        {
          "name": "COMPOSE_IMAGE_TECHNITIUM",
          "label": "Technitium DNS Server image",
          "default": "technitium/dns-server:latest"
        },
        {
          "name": "COMPOSE_PORT_DNS_WEB_CONSOLE",
          "label": "DNS web console",
          "default": "5380"
        },
        {
          "name": "COMPOSE_PORT_DNS_PORT",
          "label": "DNS port",
          "default": "53"
        },
        {
          "name": "DNS_SERVER_DOMAIN",
          "label": "DNS FQDN domain",
          "default": "dns-server"
        },
        {
          "name": "DNS_SERVER_ADMIN_PASSWORD",
          "label": "DNS web console admin password",
          "default": "technitium-admin"
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "Termix",
      "name": "termix",
      "description": "Self-hosted SSH and remote desktop management.",
      "categories": [
        "management"
      ],
      "logo": "https://termix.site/img/logo.svg",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/termix/compose.yml"
      },
      "env": [
        {
          "name": "COMPOSE_PORT_TERMIX",
          "label": "Termix port",
          "default": "127.0.0.1:2280"
        },
        {
          "name": "COMPOSE_PORT_GUACD",
          "label": "Guacamole port",
          "default": "127.0.0.1:4822"
        }
      ]
    },
    {
      "type": 3,
      "administrator_only": true,
      "title": "Traefik",
      "name": "traefik",
      "description": "A modern reverse proxy and load balancer for HTTP and TCP services.",
      "categories": [
        "load-balancer",
        "networking",
        "proxy"
      ],
      "logo": "https://doc.traefik.io/traefik/assets/img/traefik.logo.png",
      "platform": "linux",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/traefik/compose.yml"
      },
      "env": [
        {
          "name": "COMPOSE_IMAGE_TRAEFIK",
          "label": "Traefik Image",
          "default": "traefik:latest"
        },
        {
          "name": "COMPOSE_PORT_HTTP",
          "label": "HTTP Port",
          "default": "80"
        },
        {
          "name": "COMPOSE_PORT_HTTPS",
          "label": "HTTPS Port",
          "default": "443"
        },
        {
          "name": "COMPOSE_PORT_TRAEFIK",
          "label": "Traefik port",
          "default": "127.0.0.1:8080"
        }
      ]
    },
    {
      "type": 3,
      "title": "UpSnap",
      "name": "upsnap",
      "description": "A simple wake on lan web app written with SvelteKit, Go and PocketBase.",
      "categories": [
        "networking",
        "utility"
      ],
      "platform": "linux",
      "logo": "https://github.com/seriousm4x/UpSnap/raw/master/frontend/static/gopher.svg",
      "repository": {
        "url": "https://github.com/socheatsok78/portainer-marketplace",
        "stackfile": "templates/upsnap/compose.yml"
      },
      "env": [
        {
          "name": "UPSNAP_HTTP_LISTEN",
          "label": "HTTP Listen Address",
          "default": "0.0.0.0:8090"
        },
        {
          "name": "UPSNAP_INTERVAL",
          "label": "Ping Interval",
          "default": "*/10 * * * * *"
        },
        {
          "name": "UPSNAP_SCAN_RANGE",
          "label": "Network Scan Range",
          "default": "192.168.1.0/24"
        },
        {
          "name": "UPSNAP_SCAN_TIMEOUT",
          "label": "Network Scan Timeout",
          "default": "500ms"
        },
        {
          "name": "UPSNAP_LOG_LEVEL",
          "label": "Log Level",
          "select": [
            {
              "text": "DEBUG",
              "value": "DEBUG"
            },
            {
              "text": "INFO",
              "value": "INFO",
              "default": true
            },
            {
              "text": "WARN",
              "value": "WARN"
            },
            {
              "text": "ERROR",
              "value": "ERROR"
            },
            {
              "text": "OFF",
              "value": "OFF"
            }
          ]
        }
      ]
    }
  ]
}
